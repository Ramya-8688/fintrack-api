# Database Configuration
DATABASE_PROVIDER=SqlServer
DATABASE_CONNECTION_STRING=Server=localhost,1433;Database=FinTrackDb;User Id=sa;Password=YourPassword123!;

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-that-is-at-least-32-characters-long-change-in-production
JWT_ISSUER=fintrack-api
JWT_AUDIENCE=fintrack-client
JWT_EXPIRATION_MINUTES=60

# Application Settings
ASPNCORE_ENVIRONMENT=Development
DOTNET_CLI_TELEMETRY_OPTOUT=true

# Logging
LOG_LEVEL=Information
LOG_FILE_PATH=logs/fintrack-{Date}.log

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
